generator client {
	provider = "prisma-client"
	output   = "../generated/prisma"
}

datasource db {
	provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchlist WatchlistEntry[]
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  year        String
  runtime     String
  director    String
  writer      String
  cast        String
  imdbRating  Float
  tomatoScore Int
  genre       String
  plot        String
  posterUrl   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  watchlist   WatchlistEntry[]

  @@index([title])
}

model WatchlistEntry {
    id        String   @id @default(uuid())
    userId    String
    movieId   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    user      User     @relation(fields: [userId], references: [id])
    movie     Movie    @relation(fields: [movieId], references: [id])

    @@unique([userId, movieId])
    @@index([userId])
    @@index([movieId])
}